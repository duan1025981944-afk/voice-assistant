{
  "providers": {
    "deepseek": {
      "kind": "openai_compat",
      "apiKey": "${DEEPSEEK_API_KEY}",
      "baseUrl": "https://api.deepseek.com"
    }
  },
  "modelPresets": {
    "ds": {
      "provider": "deepseek",
      "model": "deepseek-flash",
      "pricing": {
        "currency": "元",
        "cacheHit": 0.02,
        "cacheMiss": 1.0,
        "output": 4.0,
        "peakMultiplier": 2,
        "peakHours": ["09:00-12:00", "14:00-18:00"]
      }
    }
  },
  "agents": {
    "defaults": { "modelPreset": "ds", "maxIterations": 6 }
  },
  "voice": {
    "assistantName": "大肥鱼",
    "wakeWords": ["大肥鱼"],
    "hotkey": "win+alt+space",
    "inputDevice": null,
    "ttsVoice": "zh-CN-XiaoyiNeural",
    "ttsRate": "+8%",
    "ttsPitch": "+15Hz",
    "searchEngine": "bing",
    "showStatus": true,
    "appAliases": {
      "网易云": "网易云音乐",
      "浏览器": "Microsoft Edge"
    }
  }
}
