{
  "providers": {
    "deepseek": {
      "kind": "openai_compat",
      "apiKey": "${DEEPSEEK_API_KEY}",
      "baseUrl": "https://api.deepseek.com"
    }
  },
  "modelPresets": {
    "ds": { "provider": "deepseek", "model": "deepseek-flash" }
  },
  "agents": {
    "defaults": { "modelPreset": "ds", "maxIterations": 6 }
  },
  "voice": {
    "assistantName": "小智",
    "wakeWords": ["你好小智","小智小智"],
    "hotkey": "win+alt+space",
    "inputDevice": null,
    "ttsVoice": "zh-CN-XiaoxiaoNeural",
    "searchEngine": "bing",
    "appAliases": {
      "网易云": "网易云音乐",
      "浏览器": "Microsoft Edge"
    }
  }
}
